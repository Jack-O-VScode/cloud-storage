# Copy this file to .env and fill in real values before running
# `docker compose up`.

# Required: a long random string used to sign login sessions.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Where uploaded files and metadata.json are stored. Point this at your
# mounted storage volume, e.g. /mnt/storage/cloud-storage-data
DATA_DIR=./data

# Port exposed on the host.
HOST_PORT=3000

# Max size of a single uploaded file, in bytes. Default: 20GB.
MAX_UPLOAD_BYTES=21474836480

# Set to true only if you are terminating HTTPS in front of this app
# (e.g. via a reverse proxy) so secure cookies are enforced.
FORCE_HTTPS=false

# Only needed if you're using docker-compose.proxy.yml (Caddy reverse proxy
# with automatic HTTPS). Must be a real hostname that resolves to this
# server's public IP - Let's Encrypt can't issue a certificate for a bare IP.
# e.g. yourname.duckdns.org, or a domain/subdomain you own.
DOMAIN=
